{
  "applicationId": "com.neutralino.sample",
  "dataLocation": "system",
  "version": "1.0.0",
  "defaultMode": "window",
  "documentRoot": "/www/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": true,
  "nativeAllowList": [
    "app.*"
  ],
  "modes": {
    "window": {
      "title": "Hello Neutralinojs",
      "width": 800,
      "height": 600,
      "minWidth": 800,
      "minHeight": 600,
      "icon": "/www/icon.png"
    }
  },
  "cli": {
    "binaryName": "neutralinojs-empty",
    "resourcesPath": "/www/",
    "extensionsPath": "/extensions/",
    "clientLibrary": "/www/neutralino.js"
  }
}
